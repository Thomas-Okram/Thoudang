# Thoudang deployment settings — copy to deploy/thoudang.env (never commit the copy).
# Read by docker-compose.yml (env_file). Paths/ports are fixed in the compose file.

# ---- AI provider ------------------------------------------------------------------------------
# anthropic : Claude API (structured outputs). Needs ANTHROPIC_API_KEY.
# bedrock   : Amazon Bedrock India geographic inference profile — data stays in
#             ap-south-1 (Mumbai) / ap-south-2 (Hyderabad). JSON-in-text + validation + repair.
AI_PROVIDER=bedrock

# anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# bedrock — confirm the profile ID before go-live:
#   aws bedrock list-inference-profiles --region ap-south-1 \
#     --query "inferenceProfileSummaries[?starts_with(inferenceProfileId,'in.anthropic')].inferenceProfileId"
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=in.anthropic.claude-sonnet-5
# Keep CLAUDE_MODEL equal to BEDROCK_MODEL_ID when using bedrock so /api/health and the
# offline cache key report the model that actually ran.
# CLAUDE_MODEL=in.anthropic.claude-sonnet-5
# AWS credentials for a least-privilege IAM user/role (bedrock:InvokeModel on the profile only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

CLAUDE_TIMEOUT_MS=60000
CLAUDE_MAX_RETRIES=2
CLAUDE_CONCURRENCY=3

# live = call the AI (fall back to cache on failure). Never use cache_* modes in production.
DEMO_MODE=live

# ---- Citizen links & notices ------------------------------------------------------------------
# REQUIRED: long random secret (openssl rand -hex 32). Rotating it invalidates printed links.
STATUS_LINK_SECRET=
# Optional Manipuri notice audio. Empty → "Audio unavailable".
GEMINI_API_KEY=

# ---- Cost reporting (Trust Report) ------------------------------------------------------------
PRICE_INPUT_PER_MTOK=2
PRICE_OUTPUT_PER_MTOK=10
PRICE_USD_INR=88
