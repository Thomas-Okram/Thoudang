{
  "name": "thoudang",
  "private": true,
  "version": "0.1.0",
  "description": "AI scrutiny desk for welfare officers — Social Welfare Department, Govt of Manipur (AI4SEVA SW-03)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @thoudang/api\" \"npm run dev -w @thoudang/web\"",
    "test": "npm run test --workspaces --if-present && npm run test:synth",
    "seed": "npm run seed -w @thoudang/api",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tools/synth",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "npm run eval -w @thoudang/api --",
    "smoke": "npm run smoke -w @thoudang/api --",
    "make-specimens": "npm run make-specimens -w @thoudang/api --",
    "demo": "npm run build -w @thoudang/web && npm run demo -w @thoudang/api",
    "demo:prime": "npm run demo:prime -w @thoudang/api --",
    "dev:fixtures": "npm run dev:fixtures -w @thoudang/api --",
    "notices:prime": "npm run notices:prime -w @thoudang/api",
    "seed:dashboard": "npm run seed:dashboard -w @thoudang/api --",
    "fairness": "npm run fairness -w @thoudang/api --",
    "audit:verify": "npm run audit:verify -w @thoudang/api --",
    "retention": "npm run retention -w @thoudang/api --",
    "test:synth": "vitest run --root tools/synth",
    "synth": "tsx tools/synth/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "concurrently": "^9.2.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
