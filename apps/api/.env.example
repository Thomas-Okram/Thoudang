# Copy to .env and fill in. .env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=

# live | cache_first | cache_only   (use cache_first on stage; cache_only if the network is down)
DEMO_MODE=live

# Optional overrides
PORT=3001
WEB_PORT=5173
DB_PATH=./data/thoudang.db
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_TIMEOUT_MS=60000
CLAUDE_MAX_RETRIES=2
CLAUDE_CONCURRENCY=3
CLAUDE_EFFORT_CLASSIFY=low
CLAUDE_EFFORT_EXTRACT=medium
