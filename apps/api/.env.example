# Copy to .env and fill in. .env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=

# AI provider: anthropic (default, needs ANTHROPIC_API_KEY) | bedrock (AWS creds, India region)
AI_PROVIDER=anthropic
# BEDROCK_REGION=ap-south-1
# BEDROCK_MODEL_ID=in.anthropic.claude-sonnet-5

# live | cache_first | cache_only   (use cache_first on stage; cache_only if the network is down)
DEMO_MODE=live

# Optional overrides
PORT=3001
WEB_PORT=5173
DB_PATH=./data/thoudang.db
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_TIMEOUT_MS=60000
CLAUDE_MAX_RETRIES=2
CLAUDE_CONCURRENCY=3
CLAUDE_EFFORT_CLASSIFY=low
CLAUDE_EFFORT_EXTRACT=medium

# Citizen notice audio (Gemini TTS). Leave empty → notices show "Audio unavailable".
GEMINI_API_KEY=
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
# Trust Report cost in ₹
PRICE_USD_INR=88
# Signs citizen status links (/s/<ref>?k=…). Change for any shared deployment.
STATUS_LINK_SECRET=change-me

# ── Security (see docs/security/) ────────────────────────────────────────────
# session = officers sign in at /login (pick officer → 4-digit PIN; signed httpOnly cookie);
#           X-Officer-Id from the browser is ignored.
# header  = legacy "Acting as" dropdown, NOT authenticated — stage fallback only if sign-in breaks.
AUTH_MODE=session
# 1 = case data, images, dashboard, uploads, SSE also need a signed-in officer (the web app sends
# you to /login on any 401). Phone-upload QR links and citizen status pages stay public.
REQUIRE_SIGN_IN=1
# DEMO PINs — DSWO Imphal West 2468 (can approve), Dealing Assistant 1357.
# Change for any shared deployment. Format: officerId:PIN (4–8 digits), comma-separated.
OFFICER_PINS=dswo-imphal-west:2468,da-imphal-west:1357
# Signs session cookies. Unset → random per process (everyone signs in again after a restart).
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12
# Wrong PINs before a 5-minute lock-out; sign-in attempts per 5 min per client.
PIN_MAX_FAILED=5
PIN_LOCKOUT_MIN=5
RATE_LIMIT_LOGIN_PER_5MIN=10
RATE_LIMIT_UPLOADS_PER_MIN=120
# Extra browser origins allowed besides localhost / private LAN on PORT & WEB_PORT (comma-separated).
CORS_ORIGINS=
# Uploads: JPEG/PNG/WebP/HEIC only (checked by content); GPS is stripped from stored copies.
MAX_UPLOAD_FILE_MB=20
MAX_BATCH_FILES=400
MAX_BATCH_MB=600
# Delete uploaded images N days after a case is approved (closed). 0 = keep forever.
RETENTION_DAYS=30
# HMAC key for the tamper-evident audit hash chain. Keep it OUT of the database.
AUDIT_CHAIN_KEY=change-me-too
